# Copy to .env and adjust. Every value has a default in docker-compose.yml.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=8080

# Needed to answer questions (Claude Haiku). Without it uploads and search still work,
# but /query returns an error. Never commit the real key: .env is gitignored.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Hugging Face read token (huggingface.co/settings/tokens). The models are public, so
# downloads work without it; with it they are authenticated (higher rate limits, no warning).
# Leave empty to skip. Never commit the real token: .env is gitignored.
HF_TOKEN=
